{
  "cases": [
    {
      "name": "basic chat completion",
      "kind": "openai_request",
      "providerModel": "gpt-4o-mini",
      "stream": false,
      "request": {
        "model": "fast",
        "messages": [{ "role": "user", "content": "hi" }]
      },
      "expected": {
        "model": "gpt-4o-mini",
        "messages": [{ "role": "user", "content": "hi" }]
      }
    },
    {
      "name": "full optional params map through; unset ones stay absent",
      "kind": "openai_request",
      "providerModel": "gpt-4o",
      "stream": false,
      "request": {
        "model": "smart",
        "messages": [
          { "role": "system", "content": "be terse" },
          { "role": "user", "content": "hi" }
        ],
        "temperature": 0.5,
        "top_p": 0.9,
        "max_tokens": 256,
        "stop": ["END"],
        "response_format": { "type": "json_object" },
        "user": "u_123"
      },
      "expected": {
        "model": "gpt-4o",
        "messages": [
          { "role": "system", "content": "be terse" },
          { "role": "user", "content": "hi" }
        ],
        "temperature": 0.5,
        "top_p": 0.9,
        "max_tokens": 256,
        "stop": ["END"],
        "response_format": { "type": "json_object" },
        "user": "u_123"
      }
    },
    {
      "name": "tools and tool_choice pass through",
      "kind": "openai_request",
      "providerModel": "gpt-4o-mini",
      "stream": false,
      "request": {
        "model": "fast",
        "messages": [{ "role": "user", "content": "weather?" }],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "get_weather",
              "description": "Get weather",
              "parameters": { "type": "object", "properties": { "city": { "type": "string" } } }
            }
          }
        ],
        "tool_choice": "auto"
      },
      "expected": {
        "model": "gpt-4o-mini",
        "messages": [{ "role": "user", "content": "weather?" }],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "get_weather",
              "description": "Get weather",
              "parameters": { "type": "object", "properties": { "city": { "type": "string" } } }
            }
          }
        ],
        "tool_choice": "auto"
      }
    },
    {
      "name": "stream mode sets stream + include_usage",
      "kind": "openai_request",
      "providerModel": "gpt-4o-mini",
      "stream": true,
      "request": {
        "model": "fast",
        "messages": [{ "role": "user", "content": "hi" }]
      },
      "expected": {
        "model": "gpt-4o-mini",
        "messages": [{ "role": "user", "content": "hi" }],
        "stream": true,
        "stream_options": { "include_usage": true }
      }
    },
    {
      "name": "multimodal content arrays pass through natively",
      "kind": "openai_request",
      "providerModel": "gpt-4o-mini",
      "stream": false,
      "request": {
        "model": "fast",
        "messages": [
          {
            "role": "user",
            "content": [
              { "type": "text", "text": "what is this?" },
              { "type": "image_url", "image_url": { "url": "https://ex.com/cat.jpg", "detail": "low" } }
            ]
          }
        ]
      },
      "expected": {
        "model": "gpt-4o-mini",
        "messages": [
          {
            "role": "user",
            "content": [
              { "type": "text", "text": "what is this?" },
              { "type": "image_url", "image_url": { "url": "https://ex.com/cat.jpg", "detail": "low" } }
            ]
          }
        ]
      }
    },
    {
      "name": "openai: basic completion response",
      "kind": "openai_response",
      "providerModel": "gpt-4o-mini",
      "response": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "created": 1700000000,
        "choices": [
          {
            "index": 0,
            "message": { "role": "assistant", "content": "Hello!" },
            "finish_reason": "stop"
          }
        ],
        "usage": { "prompt_tokens": 5, "completion_tokens": 2, "total_tokens": 7 }
      },
      "expected": {
        "id": "chatcmpl-1",
        "model": "gpt-4o-mini-2024-07-18",
        "provider": "openai",
        "created": 1700000000,
        "usage": { "prompt_tokens": 5, "completion_tokens": 2, "total_tokens": 7 },
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": { "role": "assistant", "content": "Hello!" }
          }
        ]
      }
    },
    {
      "name": "openai: response with tool_calls",
      "kind": "openai_response",
      "providerModel": "gpt-4o-mini",
      "response": {
        "id": "chatcmpl-2",
        "model": "gpt-4o-mini-2024-07-18",
        "created": 1700000000,
        "choices": [
          {
            "index": 0,
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                { "id": "call_1", "type": "function", "function": { "name": "get_weather", "arguments": "{\"city\":\"Paris\"}" } }
              ]
            },
            "finish_reason": "tool_calls"
          }
        ],
        "usage": { "prompt_tokens": 10, "completion_tokens": 8, "total_tokens": 18 }
      },
      "expected": {
        "id": "chatcmpl-2",
        "model": "gpt-4o-mini-2024-07-18",
        "provider": "openai",
        "created": 1700000000,
        "usage": { "prompt_tokens": 10, "completion_tokens": 8, "total_tokens": 18 },
        "choices": [
          {
            "index": 0,
            "finish_reason": "tool_calls",
            "message": {
              "role": "assistant",
              "content": null,
              "tool_calls": [
                { "id": "call_1", "type": "function", "function": { "name": "get_weather", "arguments": "{\"city\":\"Paris\"}" } }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "openai: null content preserved as null",
      "kind": "openai_response",
      "providerModel": "gpt-4o-mini",
      "response": {
        "id": "chatcmpl-3",
        "model": "gpt-4o-mini-2024-07-18",
        "created": 1700000000,
        "choices": [
          {
            "index": 0,
            "message": { "role": "assistant", "content": null },
            "finish_reason": "stop"
          }
        ]
      },
      "expected": {
        "id": "chatcmpl-3",
        "model": "gpt-4o-mini-2024-07-18",
        "provider": "openai",
        "created": 1700000000,
        "usage": null,
        "choices": [
          {
            "index": 0,
            "finish_reason": "stop",
            "message": { "role": "assistant", "content": null }
          }
        ]
      }
    }
  ]
}
