{
  "name": "@ai-router/core",
  "version": "0.1.0",
  "description": "Provider-agnostic AI routing core: fallback chains, key pools, rate limiting, unified streaming. Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "conformance": "tsx conformance/run.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
